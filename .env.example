# ===================== glm-bridge =====================
# انسخ الملف ده لـ .env وعدّل اللي محتاجه. كل القيم هنا هي الافتراضية إلا API_KEYS.

# ---------- السيرفر ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# سجلات JSON (مفيدة مع Docker/Loki)
LOG_JSON=false
# لا تفعّلها في الإنتاج: بتسجّل نص الطلبات
LOG_PROMPTS=false
# مثال: https://my-app.com,http://localhost:3000  (فاضي = CORS مقفول)
CORS_ORIGINS=
MAX_BODY_BYTES=16777216
# لو السيرفر ورا reverse proxy/دومين: الرابط العام (لروابط الصور المولّدة)
PUBLIC_BASE_URL=

# ---------- المصادقة ----------
# مفتاح أو أكثر مفصولين بفاصلة. ولّد مفتاح:  python -m glm_bridge keygen
# ينفع تكتب المفتاح نفسه أو الـ hash بتاعه:  sha256:<hex>
API_KEYS=
# بديل متقدم: ملف JSON  [{"name":"n8n","key_sha256":"...","rpm":30}]
API_KEYS_FILE=
# طلبات في الدقيقة لكل مفتاح (0 = بلا حد)
DEFAULT_RPM=60
# true = بدون مفتاح. للتجربة على جهازك فقط
AUTH_DISABLED=false

# ---------- الموقع (upstream) ----------
UPSTREAM_BASE_URL=https://glm-ai.chat
UPSTREAM_USER_AGENT=Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36
UPSTREAM_REQUESTED_WITH=com.duckduckgo.mobile.android
# بروكسي واحد اختياري (مثلاً لو الموقع مش بيفتح من بلد السيرفر): http://user:pass@host:port
UPSTREAM_PROXY=
UPSTREAM_TIMEOUT=180
UPSTREAM_CONNECT_TIMEOUT=15
# أقصى عدد طلبات متزامنة للموقع؛ الزيادة بتستنى في طابور
UPSTREAM_CONCURRENCY=4
UPSTREAM_QUEUE_TIMEOUT=60
# إعادة المحاولة للأخطاء المؤقتة (قبل أول كلمة فقط)
UPSTREAM_MAX_RETRIES=2
# تجديد الـ nonce استباقياً كل كام ثانية (وبيتجدد تلقائياً عند 403)
NONCE_TTL=3600
# streaming: نستنى أول كلمة كام ثانية قبل ما نبعت الـ headers
PREFLIGHT_TIMEOUT=20
KEEPALIVE_INTERVAL=15

# ---------- تشكيل البرومبت ----------
# حد حروف آخر رسالة عند الموقع
MAX_INPUT_CHARS=8000
# ميزانية تاريخ المحادثة كله؛ الأقدم بيتشال
MAX_CONTEXT_CHARS=48000
# لو آخر رسالة أطول من الحد:  error | truncate | split
OVERFLOW_POLICY=error
# مكان تعليمات الـ system:  auto | merge | primer | role   (شغّل probe عشان تعرف الأنسب)
SYSTEM_MODE=auto
# native = تمرير المحادثة كرسائل ، flatten = دمجها في رسالة واحدة
HISTORY_MODE=native
# محاكاة tool calling (لازمة لـ AI Agents في n8n/Flowise/LangChain)
TOOL_EMULATION=true

# ---------- الموديلات ----------
DEFAULT_MODEL=glm-5.3-flash
VISION_MODEL=glm-5.3-flash
VISION_MODELS=glm-5.3-flash
# لو طلب فيه صورة والموديل مش vision:  auto (حوّل لـ VISION_MODEL) | strict (خطأ) | passthrough
VISION_ROUTING=auto
# تصحيح/إضافة أسماء الموديلات عند الموقع: {"glm-4.7":"glm-4.7"}
MODEL_MAP=
# أسماء بديلة لأدوات بتفرض اسم موديل: {"gpt-4o":"glm-5.3","gpt-4o-mini":"glm-4.5-flash"}
MODEL_ALIASES=
ALLOW_UNKNOWN_MODELS=false
# لو الموقع رد بـ limit واقترح موديل تاني، نجرّبه تلقائياً؟
FOLLOW_SWITCH=false

# ---------- الصور ----------
MAX_IMAGE_BYTES=4194304
# السماح بروابط صور http(s) (مع حماية SSRF). false = base64 فقط
ALLOW_REMOTE_IMAGES=true
IMAGE_FETCH_TIMEOUT=20
IMAGE_MAX_N=4
IMAGE_CACHE_TTL=3600
IMAGE_CACHE_MAX=64

# ---------- مزوّد احتياطي (اختياري، أي API متوافق مع OpenAI) ----------
# مثال: API الرسمي لـ Zhipu/Z.ai. لو الموقع وقع، الطلب بيتحول هنا تلقائياً.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
# أنهي أعطال تفعّل الاحتياطي: offline,limit,error,unavailable,auth
FALLBACK_ON=offline,limit,error,unavailable
